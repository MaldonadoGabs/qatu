{
  "compilerOptions": {
    // File Layout
    "rootDir": "./components",
    "outDir": "./dist",

    // Environment Settings
    "module": "ES2015",
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "types": [],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options - Deshabilitados temporalmente
    "strict": false
  },
  
  "include": ["components/**/*.ts"],
  "exclude": ["node_modules"]
}
